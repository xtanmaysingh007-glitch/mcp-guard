# Copy this file to ".env" and fill in your key. NEVER commit .env.
GEMINI_API_KEY=
# Pick a model that is free in your AI Studio dashboard (check aistudio.google.com).
GEMINI_MODEL=gemini-2.5-flash
# Stay under the free-tier requests-per-minute limit (lower = safer).
GEMINI_RPM=8
# Ollama (local) settings
OLLAMA_MODEL=qwen2.5-7b-16k
OLLAMA_BASE_URL=http://localhost:11434/v1
